                                <li>Kotlin</li>
                                <li>Arduino</li>
                            </ul>
                        </div>
                        <img src="/images/tech/SeniorProject/GlowFountain.jpg" alt="Interval logo"
                            class="Project-Cover-Logo">
                    </div>
