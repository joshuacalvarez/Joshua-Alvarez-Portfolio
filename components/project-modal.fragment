                    <div class="Project-Page-Content Project-Cover">
                        <div>
                            <p class="Project-Page-Label">DATA TO BE ENTERED</p>
                            <h2>Drift</h2>
                            <p class="Project-Cover-Subtitle">
                                Full-stack music database application
                            </p>

                            <ul class="Project-Stack">
                                <li>Next.js</li>
                                <li>TypeScript</li>
                                <li>PostgreSQL</li>
                            </ul>
                        </div>
                    </div>
                </article>
            </section>
            <!-- ANAGROW -->
            <section class="Project-Details" data-project-details="anagrow" aria-hidden="true">
                <article class="Project-Page Project-Page--active">
                    <div class="Project-Page-Content Project-Cover">
                        <div>
                            <p class="Project-Page-Label">DATA TO BE ENTERED</p>
                            <h2>Anagrow</h2>
                            <p class="Project-Cover-Subtitle">
                                Word Latter Game
                            </p>

                            <ul class="Project-Stack">
                                <li>Unity</li>
                                <li>C#</li>
                                <li>Android</li>
                            </ul>
                        </div>
                    </div>
                </article>
            </section>
            <!-- BOOKCOOK -->
            <section class="Project-Details" data-project-details="bookcook" aria-hidden="true">
                <article class="Project-Page Project-Page--active">
                    <div class="Project-Page-Content Project-Cover">
                        <div>
                            <p class="Project-Page-Label">DATA TO BE ENTERED</p>
                            <h2>BookCook</h2>
                            <p class="Project-Cover-Subtitle">
                                Social Media Recipe Platform
                            </p>

                            <ul class="Project-Stack">
                                <li>Java</li>
                                <li>Spring Boot</li>
                                <li>MySQL</li>
                            </ul>
                        </div>
                    </div>
                </article>
            </section>
        </div>

        <div class="Project-Book-Navigation">
            <button class="Project-Page-Button Project-Page-Previous" type="button" aria-label="Previous page">
                <svg viewBox="0 0 24 24" aria-hidden="true">
